# ============================================
# CONFIGURACIÓN DE ENTORNO - Sistema Cobranzas Antay
# ============================================
# Instrucciones:
# 1. Copiar este archivo como .env
# 2. Completar con tus credenciales reales
# 3. NUNCA subir .env a git (está en .gitignore)
# ============================================

# ============================================
# NOTION API (obligatorio para funcionalidad actual)
# ============================================
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# SUPABASE (opcional - fallback a SQLite local si no está configurado)
# ============================================
# URL del proyecto Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Service Role Key (NO usar anon key en producción)
# Ubicación: Supabase Dashboard > Settings > API > Service Role Key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# EMAIL (opcional - para envío de reportes)
# ============================================
# SendGrid API Key
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend API Key (alternativa a SendGrid)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# WHATSAPP (futuro)
# ============================================
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ============================================
# CONFIGURACIÓN GENERAL
# ============================================
# Modo de operación: LOCAL | CLOUD
# LOCAL: usa SQLite y session_state
# CLOUD: usa Supabase para persistencia
# (Se detecta automáticamente si SUPABASE_URL está configurado)
# APP_MODE=LOCAL

# Zona horaria
# TZ=America/Lima

# Nivel de logging: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
