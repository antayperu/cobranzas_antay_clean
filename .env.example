# ============================================
# CONFIGURACIÓN DE ENTORNO - Sistema Cobranzas Antay
# ============================================
# Instrucciones:
# 1. Copiar este archivo como .env
# 2. Completar con tus credenciales reales
# 3. NUNCA subir .env a git (está en .gitignore)
# ============================================

# ============================================
# NOTION API (obligatorio para funcionalidad actual)
# ============================================
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# SUPABASE (obligatorio - arquitectura cloud-only)
# ============================================
# URL del proyecto Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Service Role Key (NO usar anon key en backend)
# Ubicación: Supabase Dashboard > Settings > API > Service Role Key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Buckets Storage (opcional; defaults: logos, exports, whatsapp-images)
# SUPABASE_STORAGE_LOGOS_BUCKET=logos
# SUPABASE_STORAGE_EXPORTS_BUCKET=exports
# SUPABASE_STORAGE_WHATSAPP_BUCKET=whatsapp-images

# IMPORTANTE:
# - SERVICE ROLE solo en backend (servidor), nunca en frontend ni repositorio.
# - ANON KEY solo para clientes/frontend (si aplica), no para migraciones ni procesos batch.

# ============================================
# EMAIL (opcional - para envío de reportes)
# ============================================
# SendGrid API Key
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend API Key (alternativa a SendGrid)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# WHATSAPP (futuro)
# ============================================
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ============================================
# CONFIGURACIÓN GENERAL
# ============================================
# Modo de operación:
# La app opera cloud-only contra Supabase.

# Zona horaria
# TZ=America/Lima

# Nivel de logging: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
