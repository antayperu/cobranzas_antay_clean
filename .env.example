# ============================================
# CONFIGURACIÓN DE ENTORNO - Sistema Cobranzas Antay
# ============================================
# Instrucciones:
# 1. Copiar este archivo como .env
# 2. Completar con tus credenciales reales
# 3. NUNCA subir .env a git (está en .gitignore)
# ============================================

# ============================================
# BASE DE DATOS — PostgreSQL local (PC QA)
# ============================================
# Formato: postgresql://usuario:password@host:puerto/base_de_datos
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/cobranzas_db

# ============================================
# NOTION API (para carga de cartera)
# ============================================
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# EMAIL (opcional - para envío de reportes)
# ============================================
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# WHATSAPP (Selenium - configurar ChromeDriver)
# ============================================
# WHATSAPP_CHROME_PROFILE=C:\Users\TU_USUARIO\AppData\Local\Google\Chrome\User Data

# ============================================
# CONFIGURACIÓN GENERAL
# ============================================
# Zona horaria
# TZ=America/Lima

# Nivel de logging: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
